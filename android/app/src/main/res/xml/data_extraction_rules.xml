<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ equivalent of backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session_prefs.preferences_pb" />
        <exclude domain="file" path="downloads" />
        <exclude domain="file" path="covers" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session_prefs.preferences_pb" />
        <exclude domain="file" path="downloads" />
        <exclude domain="file" path="covers" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
