<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds are HTTPS-only; TLS ends at Cloudflare. Debug builds override this in src/debug for the HTTP dev backend. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
