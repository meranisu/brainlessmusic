<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP for a dev backend (-PserverUrl=http://10.0.2.2:3000). Release is HTTPS-only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
