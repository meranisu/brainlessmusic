<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (overrides src/main): allow plain HTTP so a build can be
  pointed at the WSL2/LAN dev backend with -PserverUrl=http://10.0.2.2:3000.
  Release builds are HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
